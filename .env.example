# Copy this file to .env and fill it in — or just run ./setup.sh, which
# generates a real .env for you with fresh random secrets and a working
# local database already configured. Values below are placeholders, not
# safe to use as-is.

# --- Server ---
PORT=8000
NODE_ENV=development

# --- Database ---
# setup.sh points this at a local, project-only MongoDB replica set
# (scripts/start-dev-mongo.js) — a replica set, not a standalone mongod,
# because some endpoints (school creation) use a real multi-document
# transaction, which a standalone mongod rejects outright.
DATABASE=mongodb://127.0.0.1:27018/schoolmanagementapp?replicaSet=rs0

# --- CORS ---
# Comma-separated origins allowed to call this API before any School
# record exists to check against (see utilities/corsOrigin.js). setup.sh
# adds your local frontend dev server here automatically.
LEGACY_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth ---
# One signing secret per actor type, deliberately kept separate — a
# leaked school-staff token must never be usable as a platform-admin or
# student token, and vice versa. setup.sh generates a real random value
# for each of these; do not ship these placeholders anywhere real.
JWT_SECRET=replace-with-a-real-random-secret
JWT_SECRET_STUDENT=replace-with-a-real-random-secret
JWT_SECRET_PLATFORM=replace-with-a-real-random-secret
JWT_SECRET_PERSON=replace-with-a-real-random-secret
JWT_EXPIRES_IN=90d
COOKIE_EXP=90

# --- Stellar ---
# Encrypts custodial wallet secret keys at rest (utilities/encryption.js).
# setup.sh generates a real random value. Stellar payment features
# default to testnet and are opt-in per school subscription plan — see
# utilities/stellar/client.js and my-todo.md's Stage 6 write-up.
STELLAR_KEY_ENCRYPTION_SECRET=replace-with-a-real-random-secret
STELLAR_NETWORK=testnet

# --- Firebase ---
# Used for real-time chat/notifications, and to mint a custom auth token
# during staff login. setup.sh generates a disposable, self-signed key
# (scripts/generate-dev-firebase-key.js) so you do not need a real
# Firebase project to develop locally: login and the core app work;
# Firestore-backed chat/push notifications will not, until you swap in a
# real project's credentials here instead.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# --- Rate limiting (optional — app.js falls back to sane defaults) ---
# RATE_LIMIT_ATTEMPTS=10
# RATE_LIMIT_WAIT_TIME=180000

# --- Soroban (advanced, optional) ---
# Only needed for the on-chain subscription-billing smart contract flow.
# See contracts/README.md.
# SOROBAN_SUBSCRIPTION_CONTRACT_ID=
# SOROBAN_USDC_CONTRACT_ID=
